<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#fffaf7" />
  <meta name="description" content="Un pequeño mundo hecho con amor para Dayana." />
  <title>Para Dayana · Nuestro mundito</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&family=Sacramento&display=swap');
    :root {
      --cream: #fffaf4;
      --paper: #fffdfb;
      --blush: #f8dfe6;
      --rose: #e993a9;
      --rose-deep: #9a4d67;
      --ink: #4d4351;
      --muted: #756772;
      --sky: #dff1f5;
      --sky-deep: #5f929e;
      --butter: #fff1bb;
      --line: rgba(183,95,121,.18);
      --shadow: 0 22px 60px rgba(107, 74, 91, .12);
      --shadow-soft: 0 10px 28px rgba(107, 74, 91, .08);
      --serif: 'Playfair Display', Georgia, serif;
      --sans: 'DM Sans', system-ui, sans-serif;
      --script: 'Sacramento', cursive;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--cream);
      color: var(--ink);
      font-family: var(--sans);
      overflow-x: hidden;
    }
    body.locked { overflow: hidden; }
    button, input, textarea, select { font: inherit; }
    button { cursor: pointer; }
    img { max-width: 100%; display: block; }
    a { color: inherit; }
    ::selection { background: var(--blush); color: var(--rose-deep); }

    .sky-dots, .sky-dots::before, .sky-dots::after {
      position: fixed; inset: 0; pointer-events: none; z-index: -1; content: '';
    }
    .sky-dots { opacity: .5; background-image: radial-gradient(circle, rgba(233,147,169,.32) 1px, transparent 1.5px); background-size: 42px 42px; }
    .sky-dots::before { background-image: radial-gradient(circle, rgba(126,185,198,.18) 1px, transparent 1px); background-size: 77px 77px; transform: translate(21px, 15px); }
    .sky-dots::after { background: radial-gradient(ellipse at 10% 0%, rgba(255,241,187,.34), transparent 32%), radial-gradient(ellipse at 100% 15%, rgba(223,241,245,.62), transparent 32%); }

    .prelude {
      position: fixed; inset: 0; z-index: 50; display: grid; place-items: center; padding: 24px;
      background: linear-gradient(145deg, #fffaf5 0%, #fae8ee 50%, #e7f6f7 100%);
      transition: opacity .8s ease, visibility .8s ease, transform .8s ease;
      overflow: hidden;
    }
    .prelude.is-gone { opacity: 0; visibility: hidden; transform: scale(1.05); pointer-events: none; }
    .prelude-inner { width: min(650px, 100%); text-align: center; position: relative; }
    .prelude-kicker, .eyebrow { color: var(--rose-deep); text-transform: uppercase; letter-spacing: .18em; font-size: .71rem; font-weight: 700; }
    .prelude h1 { font: 600 clamp(2.8rem, 8vw, 5.5rem)/.92 var(--serif); margin: 18px 0 22px; color: #5d4654; }
    .prelude-copy { font: 1.3rem/1.6 var(--script); max-width: 540px; margin: 0 auto 26px; color: #775e6c; }
    .enter-button, .primary-button {
      border: 0; border-radius: 999px; padding: 15px 24px; background: var(--rose-deep); color: #fff; font-weight: 700; letter-spacing: .01em;
      box-shadow: 0 10px 22px rgba(183,95,121,.24); transition: transform .25s ease, box-shadow .25s ease, background .25s ease;
    }
    .enter-button:hover, .primary-button:hover { transform: translateY(-3px); box-shadow: 0 15px 28px rgba(183,95,121,.3); background: #a8506b; }
    .enter-button:focus-visible, .primary-button:focus-visible, .ghost-button:focus-visible, .icon-button:focus-visible, .nav-link:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible { outline: 3px solid rgba(126,185,198,.7); outline-offset: 3px; }
    .tiny-note { color: var(--muted); font-size: .75rem; margin-top: 14px; }

    .character-stage { height: 188px; position: relative; margin: 4px auto 10px; }
    .dog-art { position: absolute; left: 50%; transform: translateX(-50%); width: 176px; height: 152px; }
    .dog-head { position: absolute; width: 102px; height: 86px; left: 37px; top: 21px; background: #fff; border: 3px solid #403b43; border-radius: 49% 49% 48% 48%; transform: rotate(-5deg); }
    .dog-ear { position: absolute; width: 31px; height: 74px; background: #33323a; border-radius: 50% 50% 46% 46%; top: 16px; left: 19px; transform: rotate(24deg); z-index: 2; }
    .dog-ear.right { left: 119px; top: 25px; transform: rotate(-30deg); width: 27px; height: 60px; }
    .dog-eye { position: absolute; width: 6px; height: 6px; background: #33323a; border-radius: 50%; top: 37px; left: 69px; z-index: 3; }
    .dog-eye.right { left: 101px; }
    .dog-nose { position: absolute; width: 13px; height: 9px; border-radius: 60% 40% 50% 50%; background: #33323a; top: 53px; left: 87px; z-index: 3; }
    .dog-smile { position: absolute; width: 19px; height: 9px; border-bottom: 2px solid #33323a; border-radius: 0 0 50% 50%; top: 63px; left: 80px; z-index: 3; }
    .dog-body { position: absolute; width: 68px; height: 57px; left: 55px; top: 91px; background: #fff; border: 3px solid #403b43; border-radius: 48% 48% 26% 26%; }
    .dog-foot { position: absolute; width: 31px; height: 11px; border: 3px solid #403b43; border-top: 0; border-radius: 0 0 20px 20px; top: 140px; left: 48px; background: #fff; }
    .dog-foot.r { left: 95px; }
    .dog-arm { position: absolute; width: 42px; height: 12px; border: 3px solid #403b43; border-top: 0; border-radius: 0 0 20px 20px; transform: rotate(33deg); left: 37px; top: 98px; background: #fff; z-index: 3; }
    .dog-arm.r { transform: rotate(-33deg); left: 98px; }
    .heart { color: var(--rose); font-size: 2.6rem; line-height: 1; display: inline-block; animation: heartbeat 1.8s ease-in-out infinite; }
    .dog-heart { position: absolute; z-index: 4; left: 72px; top: 84px; font-size: 2.1rem; text-shadow: 0 3px 0 #fff; }
    .bird-art { position: relative; width: 86px; height: 74px; }
    .bird-body { position: absolute; left: 22px; top: 21px; width: 43px; height: 36px; border: 2px solid #836a2a; border-radius: 55% 45% 48% 45%; background: #ffd56d; }
    .bird-head { position: absolute; left: 12px; top: 14px; width: 30px; height: 27px; background: #ffd56d; border: 2px solid #836a2a; border-radius: 55%; }
    .bird-eye { position: absolute; left: 29px; top: 24px; width: 4px; height: 4px; border-radius: 50%; background: #4d4351; z-index: 2; }
    .bird-beak { position: absolute; left: 8px; top: 27px; border: 5px solid transparent; border-right-color: #db9b39; transform: rotate(11deg); }
    .bird-wing { position: absolute; left: 43px; top: 27px; width: 18px; height: 16px; border-radius: 50%; background: #f0b94e; transform: rotate(20deg); }
    .bird-feet { position: absolute; left: 35px; top: 56px; width: 24px; height: 8px; border-top: 2px solid #836a2a; border-radius: 50%; }
    .prelude .bird-art { position: absolute; right: calc(50% - 126px); bottom: 6px; transform: rotate(6deg); }
    .sparkles { position: absolute; inset: 0; pointer-events: none; }
    .sparkles span { position: absolute; color: #fff; text-shadow: 0 0 12px #fff, 0 0 20px var(--rose); animation: twinkle 2.2s ease-in-out infinite; }
    .sparkles span:nth-child(1) { top: 8%; left: 12%; font-size: 1.1rem; }
    .sparkles span:nth-child(2) { top: 22%; right: 14%; font-size: 1.5rem; animation-delay: .6s; }
    .sparkles span:nth-child(3) { bottom: 18%; left: 22%; font-size: .9rem; animation-delay: 1.2s; }
    .sparkles span:nth-child(4) { bottom: 8%; right: 25%; font-size: 1rem; animation-delay: 1.8s; }

    .site-header { position: sticky; top: 0; z-index: 20; padding: 15px 18px; background: rgba(255,250,244,.78); backdrop-filter: blur(18px); border-bottom: 1px solid rgba(183,95,121,.09); }
    .header-inner { width: min(1180px, 100%); margin: 0 auto; display: flex; align-items: center; gap: 20px; justify-content: space-between; }
    .brand { text-decoration: none; display: flex; align-items: center; gap: 10px; font-weight: 700; letter-spacing: .02em; }
    .brand-mark { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--blush); color: var(--rose-deep); font-size: 1.2rem; }
    .brand small { display: block; color: var(--muted); font-weight: 500; font-size: .68rem; letter-spacing: .06em; text-transform: uppercase; }
    .nav { display: flex; align-items: center; gap: 5px; overflow-x: auto; scrollbar-width: none; }
    .nav::-webkit-scrollbar { display: none; }
    .nav-link { white-space: nowrap; border: 0; background: transparent; color: var(--muted); border-radius: 999px; padding: 9px 11px; font-size: .75rem; transition: .2s ease; }
    .nav-link:hover { color: var(--rose-deep); background: rgba(248,223,230,.65); }
    .music-control { display: flex; gap: 4px; align-items: center; }
    .icon-button { border: 1px solid var(--line); width: 39px; height: 39px; display: grid; place-items: center; border-radius: 50%; background: rgba(255,255,255,.7); color: var(--rose-deep); transition: transform .2s ease, background .2s ease; }
    .icon-button:hover { transform: translateY(-2px); background: #fff; }
    .note-waves { display: none; gap: 3px; align-items: end; height: 18px; }
    .music-on .note-waves { display: flex; }
    .note-waves i { display: block; width: 3px; border-radius: 4px; background: var(--rose); animation: equalize .7s ease-in-out infinite alternate; }
    .note-waves i:nth-child(1) { height: 8px; }
    .note-waves i:nth-child(2) { height: 15px; animation-delay: .15s; }
    .note-waves i:nth-child(3) { height: 11px; animation-delay: .3s; }

    main { opacity: 1; transition: opacity .6s ease; }
    .hero { min-height: 720px; width: min(1180px, calc(100% - 36px)); margin: 0 auto; display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: 40px; padding: 70px 0 50px; position: relative; }
    .hero h2 { font: 600 clamp(3.7rem, 8vw, 7.9rem)/.9 var(--serif); letter-spacing: -.04em; color: #5b4855; margin: 14px 0 26px; }
    .hero h2 em { font-family: var(--script); font-style: normal; color: var(--rose-deep); letter-spacing: 0; font-size: 1.2em; }
    .hero-lede { font: 1.45rem/1.45 var(--script); color: #806979; max-width: 570px; }
    .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; }
    .ghost-button { border: 1px solid var(--line); border-radius: 999px; padding: 14px 21px; background: rgba(255,255,255,.58); color: var(--rose-deep); font-weight: 700; transition: transform .2s ease, background .2s ease; }
    .ghost-button:hover { transform: translateY(-2px); background: #fff; }
    .hero-scene { min-height: 460px; position: relative; display: grid; place-items: center; }
    .moon { width: 300px; height: 300px; border-radius: 50%; background: #fff7d6; box-shadow: 0 0 0 22px rgba(255,247,214,.38), 0 0 90px rgba(255,232,161,.34); position: absolute; }
    .cloud { position: absolute; height: 45px; width: 150px; border-radius: 999px; background: rgba(255,255,255,.75); filter: blur(.1px); }
    .cloud::before, .cloud::after { content: ''; position: absolute; bottom: 2px; border-radius: 50%; background: inherit; }
    .cloud::before { width: 66px; height: 66px; left: 24px; }
    .cloud::after { width: 52px; height: 52px; right: 22px; }
    .cloud.one { top: 14%; left: 0; transform: scale(.75); opacity: .75; }
    .cloud.two { bottom: 16%; right: -2%; transform: scale(.9); opacity: .6; }
    .scene-dog { transform: translateY(36px) scale(1.3); z-index: 2; }
    .scene-bird { position: absolute; z-index: 3; bottom: 19%; left: 20%; transform: scale(.9); }
    .scene-house { position: absolute; width: 175px; height: 112px; bottom: 14%; left: 27%; border-radius: 10px 10px 5px 5px; background: #e993a9; border: 3px solid #a86373; z-index: 1; box-shadow: 0 15px 0 rgba(183,95,121,.1); }
    .scene-house::before { content: ''; position: absolute; left: -22px; top: -58px; width: 212px; height: 100px; background: #f7c1c9; border: 3px solid #a86373; transform: skewY(-24deg) rotate(1deg); border-radius: 8px; }
    .scene-house::after { content: '♡'; position: absolute; color: #fff; font-size: 2.4rem; left: 68px; top: 31px; z-index: 2; }
    .scroll-cue { position: absolute; bottom: 20px; left: 0; color: var(--muted); font-size: .75rem; display: flex; align-items: center; gap: 8px; }
    .scroll-cue::after { content: '↓'; font-size: 1.2rem; color: var(--rose); }

    .section { width: min(1060px, calc(100% - 36px)); margin: 0 auto; padding: 105px 0; position: relative; scroll-margin-top: 76px; }
    .section-head { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 35px; }
    .section h2 { font: 600 clamp(2.2rem, 5vw, 4.4rem)/1.02 var(--serif); color: #5b4855; margin: 9px 0 0; letter-spacing: -.035em; }
    .section-intro { max-width: 490px; color: var(--muted); line-height: 1.7; margin: 13px 0 0; }
    .date-layout { display: grid; grid-template-columns: 1.1fr .9fr; gap: 34px; align-items: center; }
    .date-card, .soft-card { background: rgba(255,255,255,.7); border: 1px solid rgba(183,95,121,.12); box-shadow: var(--shadow-soft); border-radius: 28px; padding: 34px; }
    .date-number { font: 600 clamp(5rem, 14vw, 10rem)/.8 var(--serif); letter-spacing: -.08em; color: var(--rose-deep); }
    .date-phrase { font: 1.35rem/1.45 var(--script); color: #806979; max-width: 430px; margin: 28px 0 0; }
    .counter { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 30px; }
    .counter-item { padding: 15px 8px; border-radius: 17px; background: var(--sky); text-align: center; }
    .counter-item strong { display: block; font: 600 1.7rem var(--serif); color: #527e88; }
    .counter-item span { color: #2e6873; font-size: .72rem; text-transform: uppercase; letter-spacing: .1em; }
    .date-character { min-height: 320px; display: grid; place-items: center; background: linear-gradient(145deg, rgba(223,241,245,.8), rgba(255,241,187,.46)); border-radius: 36px; position: relative; overflow: hidden; }
    .calendar { position: absolute; width: 104px; height: 116px; background: #fff; border: 3px solid #59505b; border-radius: 10px; transform: rotate(-8deg); top: 56px; right: 20%; z-index: 4; box-shadow: 7px 8px 0 rgba(183,95,121,.15); }
    .calendar::before { content: 'FEB'; display: block; padding: 7px 0; text-align: center; color: #fff; background: var(--rose); border-radius: 6px 6px 0 0; font-size: .7rem; font-weight: 700; }
    .calendar::after { content: '4'; display: block; text-align: center; padding-top: 16px; color: var(--rose-deep); font: 600 2.2rem var(--serif); }
    .date-character .scene-dog { transform: scale(.9) translate(0, 70px); }
    .date-character .dog-heart { top: 83px; }

    .letter-wrap { display: grid; grid-template-columns: .75fr 1.25fr; gap: 26px; align-items: stretch; }
    .envelope-card { background: linear-gradient(145deg, #f8dfe6, #fff5f4); border-radius: 26px; min-height: 310px; display: grid; place-items: center; position: relative; overflow: hidden; border: 1px solid rgba(183,95,121,.14); }
    .envelope { width: 230px; height: 153px; position: relative; background: #fffaf6; border: 2px solid #cf879c; border-radius: 6px; box-shadow: 0 16px 26px rgba(183,95,121,.14); transition: transform .5s ease; }
    .envelope:hover { transform: translateY(-6px) rotate(-2deg); }
    .envelope::before { content: ''; position: absolute; inset: 0; background: linear-gradient(32deg, transparent 49%, #edb8c4 50%, transparent 51%), linear-gradient(-32deg, transparent 49%, #edb8c4 50%, transparent 51%); opacity: .75; }
    .envelope-flap { position: absolute; width: 164px; height: 164px; left: 31px; top: -83px; transform: rotate(45deg); background: #f8dfe6; border-right: 2px solid #cf879c; border-bottom: 2px solid #cf879c; transition: transform .7s cubic-bezier(.2,.9,.3,1); z-index: 3; }
    .envelope-seal { position: absolute; z-index: 5; left: calc(50% - 18px); top: 61px; width: 36px; height: 36px; display: grid; place-items: center; border-radius: 50%; background: var(--rose); color: #fff; transition: opacity .3s ease; }
    .envelope.open .envelope-flap { transform: rotate(45deg) translate(3px, -70px); }
    .envelope.open .envelope-seal { opacity: 0; }
    .envelope-label { position: absolute; z-index: 4; bottom: 20px; left: 0; right: 0; text-align: center; color: var(--rose-deep); font: 1.8rem var(--script); }
    .letter-paper { background: #fffdf9; border-radius: 26px; padding: 35px; border: 1px solid rgba(183,95,121,.12); box-shadow: var(--shadow-soft); min-height: 310px; position: relative; }
    .letter-paper::before { content: ''; position: absolute; width: 74px; height: 74px; right: 22px; top: 16px; border-radius: 50%; background: rgba(255,241,187,.55); }
    .letter-paper h3 { font: 2.1rem var(--script); color: var(--rose-deep); margin: 0 0 18px; position: relative; }
    .letter-copy { line-height: 1.82; color: #685a65; white-space: pre-line; position: relative; min-height: 196px; }
    .letter-closed .letter-copy { display: grid; place-items: center; color: var(--muted); font-style: italic; }
    .type-cursor { border-right: 2px solid var(--rose); animation: blink 1s step-end infinite; }
    .letter-foot { color: var(--rose-deep); font: 1.7rem var(--script); text-align: right; margin: 18px 0 0; }

    .memory-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 22px; flex-wrap: wrap; }
    .privacy-note { font-size: .76rem; color: var(--muted); max-width: 550px; }
    .add-memory { display: inline-flex; align-items: center; gap: 8px; }
    .memory-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
    .polaroid { background: #fff; padding: 12px 12px 20px; box-shadow: var(--shadow-soft); transform: rotate(var(--tilt)); transition: transform .3s ease, box-shadow .3s ease; position: relative; border-radius: 3px; }
    .polaroid:hover { transform: rotate(0) translateY(-7px); box-shadow: var(--shadow); }
    .polaroid-media { aspect-ratio: 1 / .86; background: linear-gradient(135deg, #dff1f5, #f8dfe6); display: grid; place-items: center; overflow: hidden; color: #789aa2; }
    .polaroid-media img { width: 100%; height: 100%; object-fit: cover; }
    .polaroid h3 { font: 1.55rem var(--script); margin: 12px 4px 2px; color: #5e4b58; }
    .polaroid p { margin: 0 4px; color: var(--muted); font-size: .78rem; line-height: 1.5; }
    .polaroid-date { margin: 0 4px; color: var(--rose-deep); font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; }
    .sticker { position: absolute; right: 7px; top: -13px; font-size: 1.5rem; transform: rotate(12deg); }
    .empty-card { border: 2px dashed rgba(183,95,121,.24); background: rgba(255,255,255,.35); min-height: 250px; padding: 28px; display: grid; place-items: center; text-align: center; color: var(--muted); border-radius: 4px; transform: rotate(var(--tilt)); }
    .empty-card span { font-size: 2rem; color: var(--rose); display: block; margin-bottom: 11px; }
    .card-actions { display: flex; justify-content: flex-end; gap: 5px; padding-top: 10px; }
    .text-button { border: 0; background: transparent; color: var(--rose-deep); font-size: .73rem; padding: 5px; }
    .text-button:hover { text-decoration: underline; }

    .reasons-layout { display: grid; grid-template-columns: .75fr 1.25fr; gap: 30px; align-items: start; }
    .reasons-copy { position: sticky; top: 110px; }
    .reasons-copy .big-heart { font-size: 5rem; color: var(--rose); display: block; margin: 8px 0 16px; }
    .reasons-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
    .reason-card { min-height: 142px; perspective: 800px; cursor: pointer; }
    .reason-inner { width: 100%; height: 100%; min-height: 142px; position: relative; transition: transform .6s; transform-style: preserve-3d; }
    .reason-card.is-open .reason-inner { transform: rotateY(180deg); }
    .reason-front, .reason-back { position: absolute; inset: 0; backface-visibility: hidden; border-radius: 19px; padding: 20px; border: 1px solid rgba(183,95,121,.12); box-shadow: var(--shadow-soft); }
    .reason-front { background: rgba(255,255,255,.76); color: var(--rose-deep); display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .reason-front strong { font: 1.5rem var(--script); color: #6c5664; }
    .reason-front span { font-size: 1.4rem; }
    .reason-back { transform: rotateY(180deg); background: var(--rose-deep); color: #fff; display: flex; align-items: center; font: 1.25rem/1.3 var(--script); }
    .reason-tools { display: flex; gap: 8px; margin-top: 20px; flex-wrap: wrap; }

    .snoopy-panel { background: linear-gradient(145deg, #fff6d6, #e5f6f7); border-radius: 33px; padding: 35px; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; overflow: hidden; min-height: 390px; position: relative; }
    .snoopy-panel::after { content: '✦  ✧  ✦  ✧  ✦'; position: absolute; top: 20px; right: 20px; color: rgba(183,95,121,.35); letter-spacing: 18px; }
    .snoopy-copy { align-self: center; position: relative; z-index: 2; }
    .snoopy-copy h3 { font: 2.7rem/1 var(--script); color: var(--rose-deep); margin: 0 0 12px; }
    .snoopy-copy p { color: #7d7180; line-height: 1.65; max-width: 390px; }
    .surprise-note { min-height: 62px; padding: 14px 16px; background: rgba(255,255,255,.7); border-radius: 15px; color: var(--rose-deep); font: 1.25rem/1.3 var(--script); display: flex; align-items: center; }
    .snoopy-scene { position: relative; display: grid; place-items: center; min-height: 300px; }
    .snoopy-scene .scene-house { bottom: 9%; left: 50%; transform: translateX(-50%) scale(.84); }
    .snoopy-scene .scene-dog { position: absolute; z-index: 3; bottom: 24%; left: 50%; transform: translateX(-50%) scale(.85); }
    .snoopy-scene .scene-bird { position: absolute; z-index: 5; bottom: 13%; left: 68%; transform: scale(.75); }
    .scene-heart { position: absolute; top: 18%; left: 46%; font-size: 2.5rem; color: var(--rose); animation: floaty 3.2s ease-in-out infinite; }
