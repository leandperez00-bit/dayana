    function startCounter() { const start = new Date(2026, 1, 4, 0, 0, 0); const update = () => { let diff = Math.max(0, Date.now() - start.getTime()); const days = Math.floor(diff / 86400000); diff %= 86400000; const hours = Math.floor(diff / 3600000); diff %= 3600000; const minutes = Math.floor(diff / 60000); diff %= 60000; const seconds = Math.floor(diff / 1000); $('#days').textContent = days; $('#hours').textContent = String(hours).padStart(2, '0'); $('#minutes').textContent = String(minutes).padStart(2, '0'); $('#seconds').textContent = String(seconds).padStart(2, '0'); }; update(); setInterval(update, 1000); }

    let audioCtx, masterGain, melodyTimer, noteIndex = 0;
    const melody = [261.63, 329.63, 392.00, 329.63, 293.66, 349.23, 440.00, 349.23];
    function toggleMusic() { if (!audioCtx) { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); masterGain = audioCtx.createGain(); masterGain.gain.value = Number($('#volumeRange').value); masterGain.connect(audioCtx.destination); } if (audioCtx.state === 'suspended') audioCtx.resume(); if (melodyTimer) { clearInterval(melodyTimer); melodyTimer = null; $('#musicBtn').setAttribute('aria-pressed', 'false'); $('#musicBtn').setAttribute('aria-label', 'Activar música'); $('#musicControl').classList.remove('music-on'); return; } const playNote = () => { const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain(); osc.type = 'sine'; osc.frequency.value = melody[noteIndex++ % melody.length]; gain.gain.setValueAtTime(0, audioCtx.currentTime); gain.gain.linearRampToValueAtTime(.18, audioCtx.currentTime + .06); gain.gain.exponentialRampToValueAtTime(.001, audioCtx.currentTime + 1.1); osc.connect(gain).connect(masterGain); osc.start(); osc.stop(audioCtx.currentTime + 1.15); }; playNote(); melodyTimer = setInterval(playNote, 760); $('#musicBtn').setAttribute('aria-pressed', 'true'); $('#musicBtn').setAttribute('aria-label', 'Pausar música'); $('#musicControl').classList.add('music-on'); }

    function typeLetter() { const copy = $('#letterCopy'); copy.innerHTML = ''; let i = 0; const cursor = document.createElement('span'); cursor.className = 'type-cursor'; copy.appendChild(cursor); const tick = () => { if (i < letterText.length) { cursor.before(document.createTextNode(letterText[i])); i++; setTimeout(tick, letterText[i-1] === '\n' ? 220 : 19); } else cursor.remove(); }; tick(); }

    $('#enterBtn').addEventListener('click', () => { $('#prelude').classList.add('is-gone'); document.body.classList.remove('locked'); sprinkleHearts(window.innerWidth/2, window.innerHeight*.55, 24); setTimeout(() => $('#inicio').focus?.(), 900); });
    $$('[data-target]').forEach(btn => btn.addEventListener('click', () => scrollToId(btn.dataset.target)));
    $('#envelopeCard').addEventListener('click', () => { const env = $('.envelope', $('#envelopeCard')); const paper = $('#letterPaper'); const opening = !env.classList.contains('open'); env.classList.toggle('open', opening); paper.classList.toggle('letter-closed', !opening); if (opening) { typeLetter(); sprinkleHearts(window.innerWidth*.65, window.innerHeight*.5, 9); } });
    $('#addMemoryBtn').addEventListener('click', () => openMemoryModal());
    $('#addReasonBtn').addEventListener('click', addReason);
    $('#resetReasonsBtn').addEventListener('click', () => { reasons = defaultReasons.map((text, i) => ({ id: uuid(), text })); writeStore(STORAGE.reasons, reasons); renderReasons(); toast('Volvieron las razones base.'); });
    const snoopyMessage = ['Recordatorio: hay alguien que te ama muchísimo.', 'Ojalá pudiera abrazarte ahora mismo.', 'Eres una personita demasiado especial para mí.', 'Tu corazón merece un lugar seguro y bonito.', 'Psst… hoy también eres mi pensamiento favorito.']; let snoopyIndex = 0;
    function showSnoopyMessage() { $('#snoopyNote').textContent = snoopyMessage[snoopyIndex++ % snoopyMessage.length]; sprinkleHearts(window.innerWidth*.68, window.innerHeight*.62, 6); }
    $('#snoopyScene').addEventListener('click', showSnoopyMessage); $('#snoopyScene').addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); showSnoopyMessage(); } });
    function openComfort() { $('#comfortBox').classList.add('open'); }
    $('#comfortBox').addEventListener('click', openComfort); $('#comfortBox').addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openComfort(); } });
    $$('.feeling').forEach(btn => btn.addEventListener('click', () => { openComfort(); $$('.feeling').forEach(b => b.classList.remove('active')); btn.classList.add('active'); $('#comfortMessage').textContent = comfortMessages[btn.dataset.feeling]; }));
    $('#loveReminderBtn').addEventListener('click', () => { openComfort(); $$('.feeling').forEach(b => b.classList.remove('active')); $('#comfortMessage').textContent = 'Te amo sin pedirte que seas otra persona, sin ponerte pruebas y sin exigirte que estés bien todo el tiempo. Puedes venir a mí tal como estás. ♡'; sprinkleHearts(window.innerWidth*.7, window.innerHeight*.58, 8); });
    $('#wishForm').addEventListener('submit', e => { e.preventDefault(); const input = $('#wishText'); const text = input.value.trim(); if (!text) return; wishes.push({ id: uuid(), text, opened: false }); writeStore(STORAGE.wishes, wishes); input.value = ''; renderWishes(); toast('Tu deseo quedó guardado en un sobre.'); });
    $('#surpriseBtn').addEventListener('click', () => { const el = $('#surpriseMessage'); el.textContent = surprisePool[Math.floor(Math.random() * surprisePool.length)]; el.classList.remove('pop'); void el.offsetWidth; el.classList.add('pop'); sprinkleHearts(window.innerWidth/2, window.innerHeight*.68, 8); });
    $('#secretBtn').addEventListener('click', () => { $('#secretLetter').classList.toggle('is-visible'); if ($('#secretLetter').classList.contains('is-visible')) sprinkleHearts(window.innerWidth/2, window.innerHeight*.68, 10); });
    $('#backToStart').addEventListener('click', () => scrollToId('inicio'));
    $('#musicBtn').addEventListener('click', toggleMusic); $('#volumeRange').addEventListener('input', e => { if (masterGain) masterGain.gain.value = Number(e.target.value); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

    renderReasons(); renderMemories(); renderGarden(); renderWishes(); startCounter();
  </script>
</body>
</html>

