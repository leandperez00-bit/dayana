    function escapeHtml(str = '') { return String(str).replace(/[&<>'"]/g, ch => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#039;', '"':'&quot;' }[ch])); }

    function openModal(html) { const backdrop = $('#modalBackdrop'); $('#modalContent').innerHTML = html; backdrop.classList.add('is-open'); backdrop.setAttribute('aria-hidden', 'false'); document.body.classList.add('locked'); $$('[data-close]', backdrop).forEach(btn => btn.addEventListener('click', closeModal)); backdrop.onclick = e => { if (e.target === backdrop) closeModal(); }; }
