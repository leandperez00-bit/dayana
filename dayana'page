    function memoryCard(memory, index) { const article = document.createElement('article'); article.className = 'polaroid'; article.style.setProperty('--tilt', `${index % 2 ? 1.5 : -1.6}deg`); article.innerHTML = `<div class="sticker">${index % 2 ? '✦' : '♡'}</div><div class="polaroid-media">${memory.image ? `<img src="${memory.image}" alt="${escapeHtml(memory.title || 'Recuerdo de Dayana')}" />` : '<span style="font-size:2rem">♡</span>'}</div><h3>${escapeHtml(memory.title || 'Un momento nuestro')}</h3><div class="polaroid-date">${escapeHtml(memory.date || 'sin fecha')}</div><p>${escapeHtml(memory.description || 'Un pedacito de nuestra historia.')}</p><div class="card-actions"><button class="text-button open-memory">Abrir</button><button class="text-button edit-memory">Editar</button><button class="text-button delete-memory">Borrar</button></div>`; $('.open-memory', article).addEventListener('click', () => openMemoryDetail(memory)); $('.edit-memory', article).addEventListener('click', () => openMemoryModal(memory)); $('.delete-memory', article).addEventListener('click', () => { memories = memories.filter(m => m.id !== memory.id); writeStore(STORAGE.memories, memories); renderMemories(); toast('Recuerdo eliminado de este navegador.'); }); return article; }
    function openMemoryModal(memory = null) { const editing = Boolean(memory); openModal(`<button class="icon-button modal-close" data-close aria-label="Cerrar">×</button><h2>${editing ? 'Editar recuerdo' : 'Guardar un recuerdo'}</h2><div class="form-grid"><div class="form-row"><label for="memoryTitle">Título</label><input id="memoryTitle" maxlength="60" value="${escapeHtml(memory?.title || '')}" placeholder="Un título que te haga sonreír" /></div><div class="form-row"><label for="memoryDate">Fecha</label><input id="memoryDate" type="date" value="${escapeHtml(memory?.date || '')}" /></div><div class="form-row full"><label for="memoryDescription">Descripción</label><textarea id="memoryDescription" maxlength="240" placeholder="¿Qué significa este momento para ti?">${escapeHtml(memory?.description || '')}</textarea></div><div class="form-row full"><label for="memoryImage">Fotografía desde tu dispositivo</label><input id="memoryImage" type="file" accept="image/*" /><small class="privacy-note">Se guarda como una copia local en este navegador. Para cuidar el espacio, utiliza fotos no demasiado pesadas.</small></div></div><div class="modal-actions"><button class="ghost-button" data-close>Cancelar</button><button class="primary-button" id="saveMemory">${editing ? 'Guardar cambios' : 'Añadir al museo'}</button></div>`); $('#saveMemory').addEventListener('click', () => saveMemory(memory)); }
    function saveMemory(existing) { const title = $('#memoryTitle').value.trim(); const date = $('#memoryDate').value; const description = $('#memoryDescription').value.trim(); const file = $('#memoryImage').files[0]; const finish = (image = existing?.image || '') => { const value = { id: existing?.id || uuid(), title: title || 'Un momento nuestro', date: date || 'sin fecha', description: description || 'Un pedacito de nuestra historia.', image }; if (existing) Object.assign(existing, value); else memories.unshift(value); if (writeStore(STORAGE.memories, memories)) { closeModal(); renderMemories(); toast('Tu recuerdo quedó guardado aquí.'); } }; if (file) { if (file.size > 3_500_000) { toast('Esta foto pesa más de 3.5 MB; elige una más ligera.'); return; } const reader = new FileReader(); reader.onload = () => finish(reader.result); reader.readAsDataURL(file); } else finish(); }
    function openMemoryDetail(memory) { openModal(`<button class="icon-button modal-close" data-close aria-label="Cerrar">×</button><h2>${escapeHtml(memory.title || 'Un momento nuestro')}</h2>${memory.image ? `<img class="detail-image" src="${memory.image}" alt="${escapeHtml(memory.title || 'Recuerdo')}" />` : ''}<p class="polaroid-date">${escapeHtml(memory.date || 'sin fecha')}</p><p class="detail-caption">${escapeHtml(memory.description || 'Este momento todavía está esperando tus palabras.')}</p><div class="modal-actions"><button class="primary-button" data-close>Cerrar recuerdo</button></div>`); }

