        grid.appendChild(card);
      });
    }
    function editReason(id) { const item = reasons.find(r => r.id === id); if (!item) return; openModal(`<button class="icon-button modal-close" data-close aria-label="Cerrar">×</button><h2>Editar razón</h2><div class="form-row"><label for="reasonInput">Lo que amo de ti</label><textarea id="reasonInput" maxlength="220">${escapeHtml(item.text)}</textarea></div><div class="modal-actions"><button class="ghost-button" data-close>Cancelar</button><button class="primary-button" id="saveReason">Guardar razón</button></div>`); $('#saveReason').addEventListener('click', () => { const value = $('#reasonInput').value.trim(); if (!value) return toast('Escribe una razón antes de guardar.'); item.text = value; writeStore(STORAGE.reasons, reasons); closeModal(); renderReasons(); toast('Tu razón quedó guardada.'); }); }
    function addReason() { openModal(`<button class="icon-button modal-close" data-close aria-label="Cerrar">×</button><h2>Una razón más</h2><div class="form-row"><label for="reasonInput">Lo que amo de ti</label><textarea id="reasonInput" maxlength="220" placeholder="Escribe algo que solo tú dirías de ella…"></textarea></div><div class="modal-actions"><button class="ghost-button" data-close>Cancelar</button><button class="primary-button" id="saveReason">Agregar</button></div>`); $('#saveReason').addEventListener('click', () => { const value = $('#reasonInput').value.trim(); if (!value) return toast('Escribe una razón antes de guardar.'); reasons.push({ id: uuid(), text: value }); writeStore(STORAGE.reasons, reasons); closeModal(); renderReasons(); toast('Una razón más para quererla.'); }); }

